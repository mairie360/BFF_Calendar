  "paths": {
    "/": {
      "post": {
        "tags": [],
        "operationId": "hello",
        "responses": {
          "200": {
            "description": "Returns a greeting message",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [],
        "summary": "* Handles a GET request to the /health endpoint.\n * Responds with a simple \"OK\" message to indicate the service is healthy.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
