  "components": {
    "schemas": {
      "EventValidationStatus": {
        "type": "string",
        "enum": [
          "validated",
          "refused",
          "pending"
        ]
      },
      "EventView": {
        "type": "object",
        "required": [
          "id",
          "name",
          "start",
          "end"
        ],
        "properties": {
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetCalendarParams": {
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "properties": {
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetCalendarResultView": {
        "type": "object",
        "required": [
          "events"
