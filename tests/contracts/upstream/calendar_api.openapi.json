            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventView"
            }
          }
        }
      },
      "GetEventResultView": {
        "type": "object",
        "required": [
          "id",
          "events_start_time",
          "events_end_time",
          "name",
          "owner",
          "members"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "events_end_time": {
            "type": "string",
            "format": "date-time"
          },
          "events_start_time": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "recurrence_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "visibility": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Visibility"
              }
            ]
          }
        }
      },
      "GetMembersResultView": {
        "type": "object",
        "required": [
          "members"
        ],
        "properties": {
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            }
          }
        }
      },
      "Member": {
        "type": "object",
        "required": [
          "id",
          "validation_status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "validation_status": {
            "$ref": "#/components/schemas/EventValidationStatus"
          }
        }
      },
      "PatchEventParams": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "reccurent": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      },
      "PatchEventView": {
        "type": "object",
        "required": [
          "event_start_time",
          "event_end_time",
          "reccurence_end_date"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_end_time": {
            "type": "string",
            "format": "date-time"
          },
          "event_start_time": {
            "type": "string",
            "format": "date-time"
          },
          "intervalle": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "reccurence_end_date": {
            "type": "string",
            "format": "date-time"
          },
          "visibility": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Visibility"
              }
            ]
          }
        }
      },
      "PostEventResultView": {
        "type": "object",
        "required": [
          "event_id"
        ],
        "properties": {
          "event_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "PostEventView": {
        "type": "object",
        "required": [
          "events_start_time",
          "events_end_time"
        ],
        "properties": {
          "custom_description": {
            "type": [
              "string",
              "null"
            ]
          },
          "custom_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "custom_visibility": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Visibility"
              }
            ]
          },
          "events_end_time": {
            "type": "string",
            "format": "date-time"
          },
          "events_start_time": {
            "type": "string",
            "format": "date-time"
          },
          "owner_group_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "recurrence": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Recurrence"
              }
            ]
          }
        }
      },
      "PostMemberView": {
        "type": "object",
        "required": [
          "user_id"
        ],
        "properties": {
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Recurrence": {
        "type": "object",
        "required": [
          "type_recurrence",
          "intervalle",
          "recurrence_end_date",
          "name"
        ],
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "intervalle": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "owner_group_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "recurrence_end_date": {
            "type": "string",
            "format": "date-time"
          },
          "type_recurrence": {
            "$ref": "#/components/schemas/RecurrenceType"
          },
          "visibility": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Visibility"
              }
            ]
          }
        }
      },
      "RecurrenceType": {
        "type": "string",
        "enum": [
          "Daily",
          "Weekly",
          "Monthly",
          "Error"
        ]
      },
      "Visibility": {
        "type": "string",
        "enum": [
          "Public",
          "Private",
          "Error"
        ]
      }
    }
  }
}
