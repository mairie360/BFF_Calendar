{
  "openapi": "3.1.0",
  "info": {
    "title": "BFF Calendar API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "CalendarRecurrence": {
        "type": "object",
        "properties": {
          "frequency": {
            "type": "string",
            "enum": [
              "none",
              "daily",
              "weekly",
              "monthly"
            ],
            "description": "Fréquence de récurrence"
          },
          "interval": {
            "type": "integer",
            "minimum": 1,
            "description": "Intervalle de récurrence (par défaut 1)"
          },
          "daysOfWeek": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            "description": "Jours de la semaine (0=dimanche, 6=samedi). Utilisé pour les récurrences hebdomadaires"
          },
          "endsOn": {
            "type": "string",
            "description": "Date de fin inclusive (format YYYY-MM-DD)"
          }
        },
        "required": [
          "frequency"
        ]
      },
      "CalendarAssignee": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "Identifiant unique de la personne"
          },
          "name": {
            "type": "string",
            "description": "Nom complet affichable"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Adresse email"
          },
          "role": {
            "type": "string",
            "description": "Fonction ou rôle métier"
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL de l'image de profil"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "CalendarEvent": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "Identifiant stable. Optionnel en création, obligatoire en lecture."
          },
          "title": {
            "type": "string",
            "description": "Titre de l'événement"
          },
          "date": {
            "type": "string",
            "description": "Date de début (format YYYY-MM-DD ou DD-MM-YYYY)"
          },
          "endDate": {
            "type": "string",
            "description": "Date de fin pour les événements multi-jours (format YYYY-MM-DD ou DD-MM-YYYY)"
          },
          "category": {
            "type": "string",
            "enum": [
              "meeting",
              "activity",
              "ceremony",
              "other"
            ],
            "description": "Catégorie: meeting (Réunion), activity (Animation), ceremony (Cérémonie), other (Autre)"
          },
          "service": {
            "type": "string",
            "description": "Service ou département organisateur"
          },
          "startTime": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "description": "Heure de début au format HH:mm"
          },
          "endTime": {
            "type": "string",
            "pattern": "^\\d{2}:\\d{2}$",
            "description": "Heure de fin au format HH:mm"
          },
          "location": {
            "type": "string",
            "description": "Lieu de l'événement"
          },
          "description": {
            "type": "string",
            "description": "Description détaillée"
          },
          "assigneeIds": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            "description": "Liste des identifiants des personnes assignées"
          },
          "assignees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarAssignee"
            },
            "description": "Objets complets des personnes assignées (optionnel, peut être reconstruit côté front)"
          },
          "recurrence": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CalendarRecurrence"
              },
              {
                "description": "Règle de récurrence de l'événement"
              }
            ]
          },
          "approvalStatus": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ],
            "description": "Statut d'approbation de l'événement"
          },
          "createdById": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "Identifiant de l'utilisateur ayant créé l'événement"
          },
          "canValidate": {
            "type": "boolean",
            "description": "Indique si l’utilisateur courant peut valider ou refuser cet événement"
          },
          "canEdit": {
            "type": "boolean",
            "description": "Indique si l’utilisateur courant peut modifier cet événement"
          },
          "canDelete": {
            "type": "boolean",
            "description": "Indique si l’utilisateur courant peut supprimer cet événement"
          },
          "visibleToRoles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "user",
                "responsable",
                "mayor"
              ]
            },
            "description": "Liste des rôles pouvant voir l'événement"
          }
        },
        "required": [
          "title",
          "date"
        ]
      },
      "CalendarCategory": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Libellé affiché (ex: Réunion)"
          },
          "value": {
            "type": "string",
            "description": "Valeur interne (ex: meeting)"
          }
        },
        "required": [
          "label",
          "value"
        ]
      },
      "CalendarService": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Libellé affiché (ex: Direction générale)"
          },
          "value": {
            "type": "string",
            "description": "Valeur interne (ex: direction)"
          }
        },
        "required": [
          "label",
          "value"
        ]
      },
      "CalendarBootstrapResponse": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarEvent"
            },
            "description": "Liste des événements de la période"
          },
          "assignees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarAssignee"
            },
            "description": "Référentiel des personnes assignables"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarCategory"
            },
            "description": "Référentiel des catégories"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarService"
            },
            "description": "Référentiel des services calendrier"
          },
          "currentUser": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "role": {
                "type": "string"
              },
              "groupIds": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "groupIds"
            ],
            "description": "Utilisateur actuellement authentifié (optionnel)"
          },
          "assigneeScope": {
            "type": "string",
            "enum": [
              "all",
              "groups",
              "self"
            ],
            "description": "Périmètre du référentiel des personnes assignables"
          }
        },
        "required": [
          "events",
          "assignees",
          "categories",
          "services"
        ]
      },
      "CalendarStatistics": {
        "type": "object",
        "properties": {
          "monthCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Nombre d'événements ce mois"
          },
          "weekCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Nombre d'événements cette semaine"
          },
          "todayCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Nombre d'événements aujourd'hui"
          }
        },
        "required": [
          "monthCount",
          "weekCount",
          "todayCount"
        ]
      },
      "CalendarEventParams": {
        "type": "object",
        "properties": {
          "eventId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "Identifiant de l'événement",
            "example": "123"
          }
        },
        "required": [
          "eventId"
        ]
      },
      "CalendarEventsQuery": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "description": "Date de début (YYYY-MM-DD)"
          },
          "endDate": {
            "type": "string",
            "description": "Date de fin (YYYY-MM-DD)"
          },
          "assigneeId": {
            "type": "string",
            "description": "Filtre sur une personne assignée"
          },
          "category": {
            "type": "string",
            "description": "Filtre sur une catégorie"
          }
        }
      },
