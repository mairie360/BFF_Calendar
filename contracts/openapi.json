            "items": {
              "type": "string",
              "enum": [
                "user",
                "responsable",
                "mayor"
              ]
            },
            "description": "Liste des rôles pouvant voir l'événement"
          }
        },
        "required": [
          "title",
          "date"
        ]
      },
