        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {}
        },
        "required": [
          "code",
          "message"
        ]
      },
      "CheckApiResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "OK"
          },
          "core_api": {
            "type": "string",
            "example": "Connected"
          },
          "calendar_api": {
            "type": "string",
            "example": "Connected"
          }
        },
