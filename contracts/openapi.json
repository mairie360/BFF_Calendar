{
  "openapi": "3.1.0",
  "info": {
    "title": "bff_calendar",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CalendarRecurrence": {
        "type": "object",
        "properties": {
          "frequency": {
            "type": "string",
            "enum": [
              "none",
              "daily",
              "weekly",
              "monthly"
            ],
            "description": "Fréquence de récurrence"
          },
          "interval": {
            "type": "integer",
            "minimum": 1,
            "description": "Intervalle de récurrence (par défaut 1)",
            "example": 1
          },
          "daysOfWeek": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 6,
              "example": 1
            },
            "description": "Jours de la semaine (0=dimanche, 6=samedi). Utilisé pour les récurrences hebdomadaires"
          },
          "endsOn": {
            "type": "string",
            "pattern": "^(?:(\\d{4})-(\\d{2})-(\\d{2})|(\\d{2})[-/](\\d{2})[-/](\\d{4}))$",
            "description": "Date de fin inclusive (format YYYY-MM-DD)",
            "example": "2030-12-31"
          }
        },
        "required": [
          "frequency"
        ],
        "description": "Recurrence rule of the event"
      },
      "CalendarAssignee": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "Identifiant unique de la personne",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Nom complet affichable",
            "example": "Security Admin"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Adresse email",
            "example": "security-admin@mairie360.fr"
          },
          "role": {
            "type": "string",
            "description": "Fonction ou rôle métier",
            "example": "Admin"
          },
          "avatarUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL de l'image de profil",
            "example": "https://mairie360.fr/avatar.png"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "CalendarEvent": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ],
            "description": "Identifiant stable. Optionnel en création, obligatoire en lecture."
          },
          "title": {
            "type": "string",
            "pattern": "^[^<>]*$",
            "description": "Titre de l'événement",
            "example": "Scan event"
          },
          "date": {
            "type": "string",
            "pattern": "^(?:(\\d{4})-(\\d{2})-(\\d{2})|(\\d{2})[-/](\\d{2})[-/](\\d{4}))$",
            "description": "Date de début (format YYYY-MM-DD ou DD-MM-YYYY)",
            "example": "2030-06-15"
          },
          "endDate": {
            "type": "string",
            "pattern": "^(?:(\\d{4})-(\\d{2})-(\\d{2})|(\\d{2})[-/](\\d{2})[-/](\\d{4}))$",
            "description": "Date de fin pour les événements multi-jours (format YYYY-MM-DD ou DD-MM-YYYY)",
            "example": "2030-06-15"
          },
          "category": {
            "type": "string",
            "enum": [
              "meeting",
              "activity",
              "ceremony",
              "other"
            ],
            "description": "Catégorie: meeting (Réunion), activity (Animation), ceremony (Cérémonie), other (Autre)"
          },
          "service": {
            "type": "string",
            "pattern": "^[^<>]*$",
            "description": "Service ou département organisateur",
            "example": "direction"
          },
          "startTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "Heure de début au format HH:mm",
            "example": "09:00"
          },
          "endTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "Heure de fin au format HH:mm",
            "example": "10:00"
          },
          "location": {
            "type": "string",
            "pattern": "^[^<>]*$",
            "description": "Lieu de l'événement",
            "example": "Town hall"
          },
          "description": {
            "type": "string",
            "pattern": "^[^<>]*$",
            "description": "Description détaillée"
          },
          "assigneeIds": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ],
              "example": 1
            },
            "description": "Liste des identifiants des personnes assignées"
          },
          "assignees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarAssignee"
            },
            "description": "Objets complets des personnes assignées (optionnel, peut être reconstruit côté front)"
          },
          "recurrence": {
            "$ref": "#/components/schemas/CalendarRecurrence"
          },
          "approvalStatus": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
